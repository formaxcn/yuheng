{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Docker: Start Database",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker compose -f docker-compose.local.yml up -d postgres",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "name": "Next.js: Server-side (Backend)",
            "type": "node-terminal",
            "request": "launch",
            "command": "bun run dev",
            "env": {
                "DATABASE_URL": "postgresql://yuheng:yuheng123@localhost:5432/yuheng"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "name": "Chrome: Client-side (Frontend)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "name": "Local: Next.js (SQLite)",
            "type": "node-terminal",
            "request": "launch",
            "command": "bun run dev",
            "env": {
                "DATABASE_URL": "file:./data/yuheng.db",
                "DB_TYPE": "sqlite"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack: DB + Backend + Frontend",
            "configurations": [
                "Docker: Start Database",
                "Next.js: Server-side (Backend)",
                "Chrome: Client-side (Frontend)"
            ],
            "stopAll": true
        },
        {
            "name": "Dev: Backend + Frontend",
            "configurations": [
                "Next.js: Server-side (Backend)",
                "Chrome: Client-side (Frontend)"
            ],
            "stopAll": true
        }
    ]
}
